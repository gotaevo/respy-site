<section class="framer-qxjelk" data-framer-name="Customer stories" id="testimonials"><div class="framer-1ktfzvf" data-framer-name="Container"><div class="framer-ji0un2" data-framer-name="Heading"><div class="framer-1sbmyve" data-framer-name="Title"><div class="framer-1lfv7dz" data-framer-component-type="RichTextContainer" data-framer-name="Por dentro do Respy" style="will-change: transform; opacity: 1; transform: none;"><p class="framer-text framer-styles-preset-mhwbe4" data-styles-preset="mBEu8L286" style="--framer-text-alignment:center">Por dentro do Respy</p></div><div class="framer-1dwb1rn" data-framer-component-type="RichTextContainer" data-framer-name="Mais controle. Menos leads esquecidos." style="transform:none"><h2 class="framer-text framer-styles-preset-l1etfj" data-styles-preset="ToxYoOtLf" style="--framer-text-alignment:center">Mais controle. Menos leads esquecidos.</h2></div></div><div class="framer-i15a2k" data-framer-component-type="RichTextContainer" data-framer-name="O Respy foi feito para pequenas e médias empresas que precisam atender melhor, vender com organização e acompanhar a operação em uma única tela." style="will-change: transform; opacity: 1; transform: none;"><p class="framer-text framer-styles-preset-v167ch" data-styles-preset="y5US4QAyN" style="--framer-text-alignment:center">O Respy foi feito para pequenas e médias empresas que precisam atender melhor, vender com organização e acompanhar a operação em uma única tela.</p></div></div><div class="rb-bento" data-framer-name="Bento">

	<article class="rb-card rb-wa">
		<div class="rb-stage">
			<div class="rb-inbox" aria-hidden="true">
				<div class="rb-inbox-top"><span class="rb-chip rb-on">Todas</span><span class="rb-chip">Comercial</span><span class="rb-chip">Suporte</span></div>
				<div class="rb-row rb-new"><div class="rb-av" style="background:#16A34A">MS</div><div class="rb-t"><div class="rb-n">Mariana Souza <span class="rb-tag rb-g">Comercial</span></div><div class="rb-m">Pode me mandar o orçamento?</div></div><div class="rb-side">agora<span class="rb-badge">2</span></div></div>
				<div class="rb-row"><div class="rb-av" style="background:#0E82F6">CP</div><div class="rb-t"><div class="rb-n">Carlos Pereira <span class="rb-tag">Suporte</span></div><div class="rb-m">Obrigado, resolveu aqui!</div></div><div class="rb-side">09:42</div></div>
				<div class="rb-row"><div class="rb-av" style="background:#7C5CE0">JR</div><div class="rb-t"><div class="rb-n">Juliana Rocha <span class="rb-tag rb-g">Comercial</span></div><div class="rb-m">Áudio · 0:24</div></div><div class="rb-side">09:15<span class="rb-badge">1</span></div></div>
				<div class="rb-row"><div class="rb-av" style="background:#E0791A">LA</div><div class="rb-t"><div class="rb-n">Lucas Almeida</div><div class="rb-m">Fechado então, até amanhã</div></div><div class="rb-side">ontem</div></div>
			</div>
		</div>
		<div class="rb-cap"><h3>WhatsApp</h3><p>Todos os números em uma caixa só</p></div>
	</article>

	<article class="rb-card rb-wide rb-panel" data-rb-carousel>
		<div class="rb-panel-copy">
			<div>
				<span class="rb-hand" data-rb-eyebrow>Painel</span>
				<h3 data-rb-title>Veja a operação do dia em uma tela</h3>
				<p data-rb-text>Clientes no período, fila, vendas registradas e quem está esperando resposta há mais de 15 minutos.</p>
			</div>
			<div class="rb-dots" aria-label="Telas do Respy">
				<button type="button" class="rb-on" aria-pressed="true" aria-label="Painel"></button>
				<button type="button" aria-pressed="false" aria-label="Follow-up"></button>
				<button type="button" aria-pressed="false" aria-label="Equipe"></button>
			</div>
		</div>
		<div class="rb-slides" aria-hidden="true">
			<div class="rb-slide" data-rb-active="true">
				<div class="rb-win">
					<div class="rb-win-h"><b>Painel</b><div class="rb-seg"><span>Hoje</span><span class="rb-on">7 dias</span><span>15</span><span>30</span></div></div>
					<div class="rb-kpis">
						<div class="rb-kpi"><small>Clientes no período</small><strong>128</strong><em>+12% vs anterior</em></div>
						<div class="rb-kpi"><small>Fila de atendimento</small><strong>4</strong><em class="rb-d">+1</em></div>
						<div class="rb-kpi"><small>Com atendente</small><strong>9</strong><em>+3</em></div>
						<div class="rb-kpi"><small>Vendas registradas</small><strong>23</strong><em>+8%</em></div>
					</div>
					<div class="rb-att">
						<div class="rb-att-h">Precisa de atenção <span>3 leads</span></div>
						<div class="rb-att-r rb-pulse"><div class="rb-av" style="background:#16A34A">MS</div>Mariana Souza<span class="rb-pill rb-p-bad">Sem resposta (+15m)</span><span class="rb-wait">18 min</span></div>
						<div class="rb-att-r"><div class="rb-av" style="background:#0E82F6">CP</div>Carlos Pereira<span class="rb-pill rb-p-blue">Transbordo IA</span><span class="rb-wait">4 min</span></div>
						<div class="rb-att-r"><div class="rb-av" style="background:#7C5CE0">JR</div>Juliana Rocha<span class="rb-pill rb-p-warn">Follow-up 2</span><span class="rb-wait">1 dia</span></div>
					</div>
				</div>
			</div>
			<div class="rb-slide" data-rb-active="false">
				<div class="rb-win">
					<div class="rb-win-h"><b>Follow-up · Orçamento sem resposta</b><span>3 etapas</span></div>
					<div class="rb-steps">
						<div class="rb-step"><div class="rb-dot rb-ok">✓</div><div class="rb-step-b"><small>Etapa 1 · depois de 1 dia · enviada</small><div class="rb-bubble">Oi, Mariana! Conseguiu ver o orçamento que te mandei?</div></div></div>
						<div class="rb-step"><div class="rb-dot rb-next">2</div><div class="rb-step-b"><small>Etapa 2 · depois de 3 dias · agendada</small><div class="rb-bubble rb-q">Separei um horário pra tirar suas dúvidas. Quer conversar hoje?</div></div></div>
						<div class="rb-step"><div class="rb-dot">3</div><div class="rb-step-b"><small>Etapa 3 · depois de 7 dias</small><div class="rb-bubble rb-q">Vou encerrar por aqui. Se precisar, é só chamar.</div></div></div>
					</div>
				</div>
			</div>
			<div class="rb-slide" data-rb-active="false">
				<div class="rb-win">
					<div class="rb-win-h"><b>Distribuição de atendimento</b><span>Carga ativa</span></div>
					<div class="rb-team">
						<div class="rb-mem"><div class="rb-av" style="background:#E0791A">AN<i style="background:#16A34A"></i></div><div>Ana<div class="rb-bar"><span style="width:72%"></span></div></div><span class="rb-st" style="color:#16A34A">Disponível</span></div>
						<div class="rb-mem"><div class="rb-av" style="background:#0E82F6">BR<i style="background:#D97706"></i></div><div>Bruno<div class="rb-bar"><span style="width:90%"></span></div></div><span class="rb-st" style="color:#D97706">Ocupado</span></div>
						<div class="rb-mem"><div class="rb-av" style="background:#7C5CE0">CA<i style="background:#16A34A"></i></div><div>Camila<div class="rb-bar"><span style="width:48%"></span></div></div><span class="rb-st" style="color:#16A34A">Disponível</span></div>
						<div class="rb-mem"><div class="rb-av" style="background:#9AA0AA">DI<i style="background:#C9CCD3"></i></div><div>Diego<div class="rb-bar"><span style="width:0"></span></div></div><span class="rb-st" style="color:#9AA0AA">Offline</span></div>
					</div>
					<div class="rb-queue"><div><strong>4</strong>Fila de atendimento</div><div><strong>9</strong>Com atendente</div><div><strong>27</strong>Atribuições</div></div>
				</div>
			</div>
		</div>
	</article>

	<article class="rb-card rb-kb">
		<div class="rb-stage">
			<div class="rb-board" aria-hidden="true">
				<div class="rb-col"><h4>Novo lead <span>6</span></h4><div class="rb-lead rb-ghost"></div><div class="rb-lead"><b>Lucas Almeida</b><span class="rb-tag">Instagram</span></div><div class="rb-lead"><b>Rafaela Lima</b><span class="rb-tag rb-g">Indicação</span></div></div>
				<div class="rb-col"><h4>Em atendimento <span>4</span></h4><div class="rb-lead rb-ghost"></div><div class="rb-lead"><b>Juliana Rocha</b><span class="rb-tag">Retorno</span></div><div class="rb-lead"><b>Pedro Nunes</b><span class="rb-tag rb-g">Orçamento</span></div></div>
				<div class="rb-col"><h4>Proposta enviada <span>3</span></h4><div class="rb-lead rb-ghost"></div><div class="rb-lead"><b>Carlos Pereira</b><span class="rb-tag">R$ 1.200</span></div></div>
				<div class="rb-lead rb-mover"><b>Mariana Souza</b><span class="rb-tag rb-g">Orçamento</span></div>
			</div>
		</div>
		<div class="rb-cap"><h3>Kanban</h3><p>Cada lead na etapa certa do funil</p></div>
	</article>

	<article class="rb-card rb-ia">
		<div class="rb-stage">
			<div class="rb-chat" aria-hidden="true">
				<div class="rb-ai-h"><div class="rb-orb"></div>Respy AI<small>Tom: Consultivo</small></div>
				<div class="rb-msg rb-in">Vocês têm horário amanhã à tarde?</div>
				<div class="rb-msg rb-out rb-m2"><small>Respy AI</small>Tenho às 14h e às 16h30. Quer que eu reserve pra você?</div>
				<div class="rb-msg rb-in rb-m3">Quero falar com alguém sobre valores</div>
				<div class="rb-handoff rb-m4">Transferido para atendente humano · Ana</div>
			</div>
		</div>
		<div class="rb-cap"><h3>IA</h3><p>Atende, agenda e passa pra sua equipe</p></div>
	</article>

	<article class="rb-card rb-ag">
		<div class="rb-stage">
			<div class="rb-cal" aria-hidden="true">
				<div class="rb-cal-h">Novembro <span>Semana</span></div>
				<div class="rb-days"><span></span><span>Seg<b>10</b></span><span class="rb-today">Ter<b>11</b></span><span>Qua<b>12</b></span><span>Qui<b>13</b></span></div>
				<div class="rb-grid">
					<span class="rb-hr">09h</span><div class="rb-ev rb-b">Avaliação · Rafa</div><span></span><div class="rb-ev rb-gr">Retorno · Pedro</div><span></span>
					<span class="rb-hr">10h</span><span></span><div class="rb-ev rb-b">Consulta · Lucas</div><span></span><div class="rb-ev rb-b">Reunião</div>
					<span class="rb-hr">11h</span><div class="rb-ev rb-gr">Retorno · Ju</div><span></span><span></span><span></span>
					<span class="rb-hr">14h</span><span></span><div class="rb-ev rb-new">Mariana · 14h</div><div class="rb-ev rb-b">Avaliação</div><span></span>
					<span class="rb-hr">15h</span><span></span><span></span><span></span><div class="rb-ev rb-gr">Retorno · Carlos</div>
				</div>
				<div class="rb-toast"><i>✓</i>Lembrete enviado para Mariana · amanhã 14h</div>
			</div>
		</div>
		<div class="rb-cap"><h3>Agenda</h3><p>Agendamento e lembrete pelo WhatsApp</p></div>
	</article>

</div></div></section>

<style>
	/* Bento "Por dentro do Respy": mockups do produto em HTML/CSS */
	.rb-bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; width: 100%; font-family: "Inter", "Inter Placeholder", system-ui, sans-serif; font-size: 15px; line-height: 1.5; }
	.rb-bento * { box-sizing: border-box; }
	.rb-bento h3, .rb-bento h4, .rb-bento p { margin: 0; }
	.rb-card { position: relative; border-radius: 24px; overflow: hidden; min-height: 400px; display: flex; flex-direction: column; justify-content: space-between; padding: 28px; }
	.rb-wide { grid-column: span 2; }
	.rb-cap { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 4px; }
	.rb-cap h3 { font-size: 48px; font-weight: 600; line-height: 1; letter-spacing: -0.03em; }
	.rb-cap p { font-size: 15px; opacity: 0.85; }
	.rb-stage { position: relative; z-index: 1; flex: 1; display: flex; align-items: flex-start; justify-content: center; padding-bottom: 20px; }
	.rb-hand { font-family: "Caveat", cursive; font-size: 24px; line-height: 1; color: #6b7280; }

	.rb-av { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; color: #fff; flex: none; position: relative; }
	.rb-tag { font-size: 9.5px; font-weight: 600; padding: 1px 6px; border-radius: 99px; background: #e7f1fe; color: #0e82f6; white-space: nowrap; }
	.rb-tag.rb-g { background: #e8f7ee; color: #16a34a; }

	/* WhatsApp */
	.rb-wa { background: radial-gradient(120% 90% at 100% 0%, #7fb8f7 0%, #2f8bf3 45%, #1a5fc4 100%); color: #fff; }
	.rb-inbox { width: 100%; max-width: 310px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.35); border-radius: 18px; backdrop-filter: blur(8px); padding: 10px; display: flex; flex-direction: column; gap: 6px; box-shadow: inset 1px 1px 0 rgba(255,255,255,.25); }
	.rb-inbox-top { display: flex; gap: 6px; padding: 2px 4px 6px; }
	.rb-chip { font-size: 10.5px; font-weight: 600; padding: 3px 8px; border-radius: 99px; background: rgba(255,255,255,.18); white-space: nowrap; }
	.rb-chip.rb-on { background: #fff; color: #1a5fc4; }
	.rb-row { display: grid; grid-template-columns: 30px 1fr auto; gap: 9px; align-items: center; background: #fff; color: #141414; border-radius: 12px; padding: 8px 10px; }
	.rb-t { min-width: 0; }
	.rb-n { font-size: 12.5px; font-weight: 600; display: flex; gap: 6px; align-items: center; }
	.rb-m { font-size: 11.5px; color: #6b7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.rb-side { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; font-size: 10px; color: #9aa0aa; }
	.rb-badge { min-width: 17px; height: 17px; border-radius: 99px; background: #16a34a; color: #fff; font-size: 10px; font-weight: 700; display: grid; place-items: center; padding: 0 5px; }
	.rb-row.rb-new { animation: rb-newmsg 6s ease-in-out infinite; }
	@keyframes rb-newmsg { 0%, 8% { transform: translateY(-6px); box-shadow: 0 0 0 0 rgba(255,255,255,0); } 14% { transform: none; box-shadow: 0 0 0 3px rgba(255,255,255,.6); } 40%, 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); } }

	/* Carrossel largo */
	.rb-panel { background: #f1f2f4; color: #141414; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.25fr); gap: 28px; padding: 32px; }
	.rb-panel-copy { display: flex; flex-direction: column; justify-content: space-between; gap: 20px; }
	.rb-panel-copy h3 { font-size: 30px; font-weight: 600; line-height: 1.12; letter-spacing: -0.02em; margin-top: 8px; }
	.rb-panel-copy p { font-size: 15px; color: #5e6470; margin-top: 12px; max-width: 34ch; }
	.rb-dots { display: flex; gap: 6px; }
	.rb-dots button { appearance: none; border: 0; padding: 0; height: 6px; width: 24px; border-radius: 99px; background: #c9ccd3; cursor: pointer; overflow: hidden; position: relative; transition: width .3s ease; }
	.rb-dots button.rb-on { width: 44px; }
	.rb-dots button.rb-on::after { content: ""; position: absolute; inset: 0; background: #141414; transform-origin: left; animation: rb-fill 6s linear forwards; }
	.rb-dots button:focus-visible { outline: 2px solid #0e82f6; outline-offset: 3px; }
	@keyframes rb-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
	.rb-slides { position: relative; min-height: 340px; }
	.rb-slide { position: absolute; inset: 0; transition: opacity .45s ease, transform .45s ease; }
	.rb-slide[data-rb-active="false"] { opacity: 0; transform: translateY(8px); pointer-events: none; }
	.rb-win { background: #fff; border-radius: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.05), 0 12px 30px -12px rgba(20,30,60,.25); padding: 14px; height: 100%; display: flex; flex-direction: column; gap: 10px; }
	.rb-win-h { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 12px; color: #6b7280; }
	.rb-win-h b { color: #141414; font-size: 13px; }
	.rb-seg { display: flex; gap: 2px; background: #f1f2f4; border-radius: 8px; padding: 2px; font-size: 10.5px; }
	.rb-seg span { padding: 2px 7px; border-radius: 6px; }
	.rb-seg .rb-on { background: #fff; color: #141414; font-weight: 600; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
	.rb-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
	.rb-kpi { border: 1px solid #eceef2; border-radius: 10px; padding: 8px 9px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
	.rb-kpi small { font-size: 10px; line-height: 1.25; color: #6b7280; min-height: 25px; }
	.rb-kpi strong { font-size: 19px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
	.rb-kpi em { font-style: normal; font-size: 10px; font-weight: 600; color: #16a34a; }
	.rb-kpi em.rb-d { color: #dc2645; }
	.rb-att { display: flex; flex-direction: column; gap: 6px; }
	.rb-att-h { font-size: 11px; font-weight: 600; display: flex; justify-content: space-between; }
	.rb-att-h span { color: #6b7280; font-weight: 500; }
	.rb-att-r { display: grid; grid-template-columns: 24px 1fr auto auto; gap: 8px; align-items: center; font-size: 12px; padding: 6px 8px; border-radius: 9px; background: #fafafb; }
	.rb-att-r .rb-av { width: 24px; height: 24px; font-size: 9.5px; }
	.rb-pill { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 99px; white-space: nowrap; }
	.rb-p-bad { background: #fde8ec; color: #dc2645; }
	.rb-p-warn { background: #fef3e2; color: #b45309; }
	.rb-p-blue { background: #e7f1fe; color: #0e82f6; }
	.rb-wait { font-size: 10.5px; color: #9aa0aa; font-variant-numeric: tabular-nums; }
	.rb-pulse { animation: rb-pulse 2.4s ease-in-out infinite; }
	@keyframes rb-pulse { 0%, 100% { background: #fafafb; } 50% { background: #fdeff2; } }
	.rb-steps { display: flex; flex-direction: column; flex: 1; }
	.rb-step { display: grid; grid-template-columns: 22px 1fr; gap: 10px; position: relative; padding-bottom: 12px; }
	.rb-step::before { content: ""; position: absolute; left: 10px; top: 22px; bottom: 0; width: 2px; background: #eceef2; }
	.rb-step:last-child::before { display: none; }
	.rb-dot { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 10px; font-weight: 700; background: #eceef2; color: #6b7280; }
	.rb-dot.rb-ok { background: #16a34a; color: #fff; }
	.rb-dot.rb-next { background: #0e82f6; color: #fff; animation: rb-ring 2s ease-out infinite; }
	@keyframes rb-ring { 0% { box-shadow: 0 0 0 0 rgba(14,130,246,.45); } 100% { box-shadow: 0 0 0 8px rgba(14,130,246,0); } }
	.rb-step-b { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
	.rb-step-b small { font-size: 10.5px; color: #6b7280; }
	.rb-bubble { font-size: 12px; background: #e7f8ec; border-radius: 10px 10px 10px 3px; padding: 7px 10px; max-width: 92%; color: #14361f; }
	.rb-bubble.rb-q { background: #f1f2f4; color: #3b3f48; }
	.rb-team { display: flex; flex-direction: column; gap: 8px; }
	.rb-mem { display: grid; grid-template-columns: 28px 1fr auto; gap: 10px; align-items: center; font-size: 12.5px; }
	.rb-mem .rb-av { width: 28px; height: 28px; font-size: 10px; }
	.rb-mem .rb-av i { position: absolute; right: -1px; bottom: -1px; width: 9px; height: 9px; border-radius: 50%; border: 2px solid #fff; }
	.rb-bar { height: 6px; background: #f1f2f4; border-radius: 99px; overflow: hidden; margin-top: 4px; }
	.rb-bar span { display: block; height: 100%; border-radius: 99px; background: #0e82f6; }
	.rb-st { font-size: 10.5px; font-weight: 600; }
	.rb-queue { margin-top: auto; display: flex; gap: 8px; }
	.rb-queue div { flex: 1; border: 1px solid #eceef2; border-radius: 10px; padding: 8px 10px; font-size: 10.5px; color: #6b7280; }
	.rb-queue strong { display: block; font-size: 18px; color: #141414; font-variant-numeric: tabular-nums; }

	/* Kanban */
	.rb-kb { background: linear-gradient(160deg, #0f1b3d 0%, #0a1228 100%); color: #fff; }
	.rb-board { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; position: relative; }
	.rb-col { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: 8px; display: flex; flex-direction: column; gap: 6px; min-height: 200px; min-width: 0; }
	.rb-col h4 { min-height: 26px; line-height: 1.3; font-size: 10px; font-weight: 600; letter-spacing: .02em; color: rgba(255,255,255,.7); display: flex; justify-content: space-between; gap: 4px; }
	.rb-col h4 span { color: rgba(255,255,255,.45); }
	.rb-lead { background: #fff; color: #141414; border-radius: 8px; padding: 7px; font-size: 10.5px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
	.rb-lead b { font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.rb-lead .rb-tag { align-self: flex-start; }
	.rb-lead.rb-ghost { background: transparent; border: 1px dashed rgba(255,255,255,.22); height: 46px; flex: none; }
	.rb-lead.rb-mover { position: absolute; left: 9px; top: 41px; width: calc((100% - 16px) / 3 - 18px); box-shadow: 0 10px 24px -8px rgba(0,0,0,.6); animation: rb-move 7s cubic-bezier(.6,0,.3,1) infinite; z-index: 3; }
	@keyframes rb-move { 0%, 18% { transform: translate(0,0) rotate(0); } 26% { transform: translate(0,-6px) rotate(-3deg); } 44%, 62% { transform: translate(calc(100% + 24px), 0) rotate(0); } 70% { transform: translate(calc(100% + 24px), -6px) rotate(-3deg); } 88%, 100% { transform: translate(calc(200% + 48px), 0) rotate(0); } }

	/* IA */
