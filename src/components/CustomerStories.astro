	.rb-ai-h small { margin-left: auto; font-weight: 500; font-size: 10.5px; opacity: .8; }
	.rb-orb { width: 22px; height: 22px; border-radius: 50%; background: conic-gradient(from 0deg, #fff, #bfddfe, #fff); animation: rb-spin 4s linear infinite; }
	@keyframes rb-spin { to { transform: rotate(360deg); } }
	.rb-msg { font-size: 12px; padding: 7px 10px; border-radius: 12px; max-width: 85%; animation: rb-msg 9s ease infinite both; }
	.rb-msg.rb-in { background: #fff; color: #141414; border-bottom-left-radius: 3px; align-self: flex-start; }
	.rb-msg.rb-out { background: #0b3e86; color: #fff; border-bottom-right-radius: 3px; align-self: flex-end; }
	.rb-msg.rb-out small { display: block; font-size: 9.5px; opacity: .7; margin-bottom: 2px; }
	.rb-handoff { align-self: center; font-size: 10.5px; font-weight: 600; background: rgba(255,255,255,.95); color: #0e82f6; padding: 4px 10px; border-radius: 99px; animation: rb-msg 9s ease infinite both; }
	.rb-m2 { animation-delay: .9s; }
	.rb-m3 { animation-delay: 1.8s; }
	.rb-m4 { animation-delay: 2.7s; }
