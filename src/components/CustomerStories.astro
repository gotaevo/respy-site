</style>

<script>
	const carousel = document.querySelector('[data-rb-carousel]');
	if (carousel) {
		const copy = [
			{ eyebrow: 'Painel', title: 'Veja a operação do dia em uma tela', text: 'Clientes no período, fila, vendas registradas e quem está esperando resposta há mais de 15 minutos.' },
			{ eyebrow: 'Follow-up', title: 'Nenhum orçamento fica sem retorno', text: 'Monte uma sequência de mensagens e o Respy envia cada etapa no dia certo.' },
			{ eyebrow: 'Equipe', title: 'Cada atendente sabe o que é dele', text: 'Veja quem está disponível, quanto cada um está atendendo e quantos clientes estão na fila.' },
		];
		const slides = carousel.querySelectorAll<HTMLElement>('.rb-slide');
		const dots = carousel.querySelectorAll<HTMLButtonElement>('.rb-dots button');
		const eyebrow = carousel.querySelector('[data-rb-eyebrow]');
		const title = carousel.querySelector('[data-rb-title]');
		const text = carousel.querySelector('[data-rb-text]');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;
		let timer: number | undefined;

		const show = (index: number) => {
			current = index;
			slides.forEach((slide, i) => slide.setAttribute('data-rb-active', String(i === index)));
			dots.forEach((dot, i) => {
				dot.classList.remove('rb-on');
				dot.setAttribute('aria-pressed', String(i === index));
			});
			void dots[index].offsetWidth;
			dots[index].classList.add('rb-on');
			if (eyebrow) eyebrow.textContent = copy[index].eyebrow;
			if (title) title.textContent = copy[index].title;
			if (text) text.textContent = copy[index].text;
		};

		const start = () => {
			if (reduce) return;
			window.clearInterval(timer);
			timer = window.setInterval(() => show((current + 1) % copy.length), 6000);
		};

		dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
		start();
	}
</script>
