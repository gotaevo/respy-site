---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SvgDefs from '../SvgDefs.astro';
import Header from '../Header.astro';
import Hero from '../Hero.astro';
import TrustedBy from '../TrustedBy.astro';
import Bottleneck from '../Bottleneck.astro';
import Features from '../Features.astro';
import Usecases from '../Usecases.astro';
import CustomerStories from '../CustomerStories.astro';
import Pricing from '../Pricing.astro';
import About from '../About.astro';
import FAQ from '../FAQ.astro';
import CTA from '../CTA.astro';
import Footer from '../Footer.astro';
---

<BaseLayout
	title="Respy — CRM e atendimento no WhatsApp"
	description="Organize o atendimento da sua empresa no WhatsApp, acompanhe cada lead e automatize follow-ups com o Respy."
	lang="pt-BR"
>
	<div data-framer-generated-page="" id="main">
		<div
			class="framer-gsDDa framer-WBrhW framer-yAJxk framer-9OjJ3 framer-0FlRU framer-1fuuwg"
			data-layout-template="true"
			data-selection="true"
			style="--1vm7ife:130px 0px 0px 0px;--ihjje9:110px 0px 0px 0px;min-height:100vh;width:auto"
		>
			<div
				class="framer-VZ7wD framer-RXgLj framer-EhUGu framer-l5XXk framer-9OjJ3 framer-yAJxk framer-0FlRU framer-wn90E framer-guVoT framer-72rtr7"
				data-framer-root=""
				style="min-height:100vh;width:auto;display:contents"
			>
				<div class="framer-eywkka" data-framer-name="Header change trigger" id="header-change"></div>
				<main class="framer-1v8dk9r" data-framer-name="Main">
					<Hero />
					<TrustedBy />
					<Bottleneck />
					<Features />
					<Usecases />
					<CustomerStories />
					<Pricing />
					<About />
					<FAQ />
					<CTA />
				</main>
				<div id="overlay"></div>
				<div class="framer-5gd35e"></div>
				<Header />
				<Footer />
			</div>
		</div>
	</div>

	<SvgDefs />

	<script>
		// Smooth anchor scrolling
		document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach((anchor) => {
			anchor.addEventListener('click', function (e) {
				const href = this.getAttribute('href') ?? '';
				const hash = href.slice(href.indexOf('#'));
				if (hash && hash !== '#') {
					const target = document.querySelector(hash);
					if (target) {
						e.preventDefault();
						target.scrollIntoView({ behavior: 'smooth' });
					}
				}
			});
		});

		// Header sticky / scroll blur effect
		const headerNav = document.querySelector('.framer-wbdz5-container');
		if (headerNav) {
			const onScroll = () => {
				if (window.scrollY > 40) {
					headerNav.classList.add('scrolled');
				} else {
					headerNav.classList.remove('scrolled');
				}
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();
		}

		// FAQ Accordion
		document.querySelectorAll('[data-framer-name="FAQ"] .framer-1tza9rs').forEach((faqItem) => {
			faqItem.addEventListener('click', () => {
				faqItem.classList.toggle('active');
			});
		});
	</script>
</BaseLayout>
