---
const segments = [
	'Imobiliárias & Corretores',
	'Clínicas & Saúde',
	'E-commerce & Lojas',
	'Agências & Vendas B2B',
	'Serviços & Consultoria',
	'Cursos & Educação',
	'Concessionárias & Auto',
	'Escritórios & Advocacia',
];

const tickerList = [...segments, ...segments];
---

<section class="framer-qkxf0z segments-section" data-framer-name="Segmentos atendidos">
	<div class="framer-16hqx7z" data-framer-name="Container">
		<div class="segments-header">
			<div style="--framer-paragraph-spacing: 0px;">
				<p class="framer-text framer-styles-preset-mhwbe4" data-styles-preset="mBEu8L286" style="--framer-text-alignment:center">
					Segmentos atendidos
				</p>
			</div>
			<div style="--framer-paragraph-spacing: 0px;">
				<h2 class="framer-text framer-styles-preset-l1etfj segments-title" data-styles-preset="ToxYoOtLf" style="--framer-text-alignment:center">
					Feito sob medida para quem vende e atende no WhatsApp
				</h2>
			</div>
		</div>
	</div>

	<div class="segments-marquee" data-framer-name="Segmentos Ticker">
		<div class="marquee-track">
			<div class="marquee-group">
				{tickerList.map((title) => (
					<div class="segment-card">
						<span class="segment-title">{title}</span>
					</div>
				))}
			</div>
			<div class="marquee-group" aria-hidden="true">
				{tickerList.map((title) => (
					<div class="segment-card">
						<span class="segment-title">{title}</span>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.segments-section {
		overflow: hidden;
		width: 100%;
		padding: 40px 0 !important;
	}

	.segments-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		margin-bottom: 28px;
		gap: 6px;
		width: 100%;
		padding: 0 20px;
		box-sizing: border-box;
	}

	.segments-header p,
	.segments-header h2 {
		margin: 0 !important;
		margin-top: 0 !important;
		--framer-paragraph-spacing: 0px !important;
	}

	.segments-title {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(22px, 3vw, 32px);
		font-weight: 600;
		color: var(--token-53572612-5739-47c6-8b1a-4fdcc73f407a, #141414);
		letter-spacing: -0.03em;
		line-height: 1.25;
		margin: 0 !important;
		margin-top: 0 !important;
	}

	/* Marquee Container com fade suave nas laterais */
	.segments-marquee {
		width: 100%;
		overflow: hidden;
		position: relative;
		mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
		-webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
		padding: 8px 0;
	}

	.marquee-track {
		display: flex !important;
		flex-direction: row !important;
		flex-wrap: nowrap !important;
		width: max-content !important;
		gap: 14px !important;
	}

	.marquee-group {
		display: flex !important;
		flex-direction: row !important;
		flex-wrap: nowrap !important;
		gap: 14px !important;
		flex-shrink: 0 !important;
		animation: ticker-scroll 75s linear infinite;
		will-change: transform;
	}

	@keyframes ticker-scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(calc(-100% - 14px));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-group {
			animation-duration: 160s;
		}
	}

	/* Card Retangular Cinza sem ícone, sem subtítulo, texto #6F6F6F e maior padding */
	.segment-card {
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		background-color: var(--token-d85c14b1-24d2-4c6a-85b8-c8df39670cf6, #f2f2f2);
		border: 1px solid rgba(0, 0, 0, 0.05);
		border-radius: 14px;
		padding: 16px 28px;
		box-sizing: border-box;
		flex-shrink: 0 !important;
		user-select: none;
		cursor: default;
		pointer-events: none;
	}

	.segment-title {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: 14px;
		font-weight: 500;
		color: #6F6F6F;
		line-height: 1.2;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}
</style>
