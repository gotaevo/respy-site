---
// Seção principal da página de contato: chamada à esquerda e formulário à direita.
---

<section class="ch" data-framer-name="Contato">
	<div class="ch-box">
		<img
			class="ch-bg"
			src="/assets/a5aa55a7230074c7_8EVAG0IfgpKfNePXBusanU8q2E.jpg"
			srcset="/assets/afb19f369b794925_8EVAG0IfgpKfNePXBusanU8q2E.jpg 512w, /assets/183ea793516cf558_8EVAG0IfgpKfNePXBusanU8q2E.jpg 1024w, /assets/a5aa55a7230074c7_8EVAG0IfgpKfNePXBusanU8q2E.jpg 1511w"
			sizes="(min-width: 1200px) 1200px, 100vw"
			alt=""
			width="1511"
			height="1200"
			decoding="async"
		/>

		<div class="ch-left">
			<div class="ch-top">
				<p class="ch-eyebrow">Fale com a equipe</p>
				<h1>Estamos a uma mensagem de distância.</h1>
				<p class="ch-lead">
					Tem dúvidas sobre planos, implantação ou como o Respy funciona na sua operação? Mande uma mensagem e a equipe responde.
				</p>
			</div>
			<div class="ch-bottom">
				<p class="ch-eyebrow">Prefere comparar os planos?</p>
				<p class="ch-alt">
					Starter, Plus e Pro com os mesmos recursos.
					<a href="/#pricing">Ver planos <span aria-hidden="true">↗</span></a>
				</p>
			</div>
		</div>

		<form class="ch-form" novalidate>
			<div class="ch-row">
				<label class="ch-field">
					<span>Nome</span>
					<input id="ch-name" name="nome" type="text" placeholder="Seu nome" autocomplete="name" required />
				</label>
				<label class="ch-field">
					<span>WhatsApp <em>(opcional)</em></span>
					<input id="ch-phone" name="whatsapp" type="tel" placeholder="(00) 00000-0000" autocomplete="tel" inputmode="tel" />
				</label>
			</div>
			<label class="ch-field">
				<span>Empresa</span>
				<input id="ch-company" name="empresa" type="text" placeholder="Nome da sua empresa" autocomplete="organization" required />
			</label>
			<label class="ch-field">
				<span>E-mail</span>
				<input id="ch-email" name="email" type="email" placeholder="voce@empresa.com.br" autocomplete="email" required />
			</label>
			<label class="ch-field">
				<span>Mensagem</span>
				<textarea id="ch-message" name="mensagem" rows="5" placeholder="Conte como é o atendimento da sua equipe hoje" required></textarea>
			</label>
			<input class="ch-hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
			<button class="ch-submit" type="submit">Enviar mensagem</button>
			<p class="ch-status" role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.ch {
		display: flex;
		justify-content: center;
		width: 100%;
		padding: 0 20px;
		font-family: 'Inter', 'Inter Placeholder', system-ui, sans-serif;
	}
	.ch-box {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
		gap: 40px;
		width: 100%;
		max-width: 1200px;
		padding: 40px;
		border-radius: 32px;
		background: #0b1530;
		color: #fff;
	}
	.ch-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}
	.ch-left,
	.ch-form {
		position: relative;
		z-index: 1;
	}

	.ch-left {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 48px;
		padding: 8px 0;
	}
	.ch-top {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.ch-eyebrow {
		margin: 0;
		font-family: 'Caveat', cursive;
		font-size: 22px;
		line-height: 1.1;
		color: rgba(255, 255, 255, 0.55);
	}
	.ch h1 {
		margin: 0;
		font-size: clamp(38px, 5vw, 60px);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}
	.ch-lead {
		margin: 4px 0 0;
		max-width: 46ch;
		font-size: 17px;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.85);
	}
	.ch-bottom {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.ch-alt {
		margin: 0;
		font-size: 16px;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.9);
	}
	.ch-alt a {
		margin-left: 6px;
		color: #fff;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 4px;
		white-space: nowrap;
	}
	.ch-alt a:hover {
		color: #bcdcff;
	}

	.ch-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 24px;
		border-radius: 24px;
		background: #f2f2f2;
		color: #141414;
		box-shadow: 0 20px 50px -24px rgba(0, 0, 0, 0.55);
	}
	.ch-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.ch-field {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}
	.ch-field span {
		font-size: 13px;
		font-weight: 500;
		color: #141414;
	}
	.ch-field em {
		font-style: normal;
		color: #8a8f99;
		font-weight: 400;
	}
	.ch-field input,
	.ch-field textarea {
		width: 100%;
		box-sizing: border-box;
		padding: 12px 14px;
		border: 1px solid #dcdcdc;
		border-radius: 12px;
		background: #fff;
		font: inherit;
		font-size: 15px;
		color: #141414;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}
	.ch-field textarea {
		resize: vertical;
		min-height: 120px;
	}
	.ch-field input::placeholder,
	.ch-field textarea::placeholder {
		color: #9aa0aa;
	}
	.ch-field input:focus,
	.ch-field textarea:focus {
		outline: none;
		border-color: #0e82f6;
		box-shadow: 0 0 0 3px rgba(14, 130, 246, 0.15);
	}
	.ch-field input[aria-invalid='true'],
	.ch-field textarea[aria-invalid='true'] {
		border-color: #dc2645;
	}
	.ch-hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.ch-submit {
		margin-top: 4px;
		padding: 15px 20px;
		border: 0;
		border-radius: 9999px;
		background: #141414;
		color: #fff;
		font: inherit;
		font-size: 15px;
		font-weight: 600;
		cursor: pointer;
		box-shadow: 0 5px 13px -1px rgba(0, 0, 0, 0.32);
		transition: background-color 0.25s ease, transform 0.2s ease;
	}
	.ch-submit:hover {
		background: #0e82f6;
		transform: translateY(-1px);
	}
	.ch-submit:focus-visible {
		outline: 2px solid #0e82f6;
		outline-offset: 3px;
	}
	.ch-submit:disabled {
		opacity: 0.6;
		cursor: default;
		transform: none;
	}
	.ch-status {
		margin: 0;
		min-height: 1.4em;
		font-size: 14px;
		line-height: 1.4;
		color: #5e6470;
	}
	.ch-status[data-tone='ok'] {
		color: #11733a;
	}
	.ch-status[data-tone='error'] {
		color: #dc2645;
	}

	@media (max-width: 1199.98px) {
		.ch-box {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}
		.ch-left {
			gap: 32px;
		}
	}
	@media (max-width: 809.98px) {
		.ch {
			padding: 0;
		}
		.ch-box {
			padding: 24px 20px 20px;
			border-radius: 0;
		}
		.ch-form {
			padding: 20px;
		}
		.ch-row {
			grid-template-columns: minmax(0, 1fr);
		}
		.ch-lead {
			font-size: 16px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ch-submit {
			transition: none;
		}
	}
</style>

<script>
	// Envia o contato para a mesma planilha do Google (aba "Contato").
	const endpoint = import.meta.env.PUBLIC_NEWSLETTER_URL;
	const form = document.querySelector<HTMLFormElement>('.ch-form');

	if (form) {
		const status = form.querySelector<HTMLElement>('.ch-status');
		const button = form.querySelector<HTMLButtonElement>('.ch-submit');
		const honeypot = form.querySelector<HTMLInputElement>('.ch-hp');
		const required = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];

		const setStatus = (text: string, tone?: 'ok' | 'error') => {
			if (!status) return;
			status.textContent = text;
			if (tone) status.dataset.tone = tone;
			else delete status.dataset.tone;
		};

		required.forEach((field) => field.addEventListener('input', () => field.removeAttribute('aria-invalid')));

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (honeypot?.value) return;

			const invalid = required.filter((field) => !field.value.trim() || !field.checkValidity());
			required.forEach((field) => field.toggleAttribute('aria-invalid', invalid.includes(field)));
			if (invalid.length) {
				invalid.forEach((field) => field.setAttribute('aria-invalid', 'true'));
				invalid[0].focus();
				setStatus('Preencha nome, empresa, um e-mail válido e a mensagem.', 'error');
				return;
			}
			if (!endpoint) {
				setStatus('O envio está indisponível no momento. Tente novamente mais tarde.', 'error');
				return;
			}

			const data = Object.fromEntries(new FormData(form).entries());
			if (button) button.disabled = true;
			setStatus('Enviando...');
			try {
				// text/plain evita o preflight de CORS que o Apps Script não responde
				await fetch(endpoint, {
					method: 'POST',
					mode: 'no-cors',
					headers: { 'Content-Type': 'text/plain;charset=utf-8' },
					body: JSON.stringify({ type: 'contato', ...data, page: location.pathname }),
				});
				form.reset();
				setStatus('Mensagem enviada. A equipe vai responder no seu e-mail.', 'ok');
			} catch {
				setStatus('Não foi possível enviar. Verifique sua conexão e tente de novo.', 'error');
			} finally {
				if (button) button.disabled = false;
			}
		});
	}
</script>
