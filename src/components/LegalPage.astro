---
// Estrutura das páginas legais: mesmo Header e Footer da home, conteúdo em coluna central.
import BaseLayout from '../layouts/BaseLayout.astro';
import SvgDefs from './SvgDefs.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
	title: string;
	description: string;
	updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={`${title} — Respy`} description={description} lang="pt-BR">
	<div data-framer-generated-page="" id="main">
		<div
			class="framer-gsDDa framer-WBrhW framer-yAJxk framer-9OjJ3 framer-0FlRU framer-1fuuwg"
			data-layout-template="true"
			data-selection="true"
			style="--1vm7ife:130px 0px 0px 0px;--ihjje9:110px 0px 0px 0px;min-height:100vh;width:auto"
		>
			<div
				class="framer-VZ7wD framer-RXgLj framer-EhUGu framer-l5XXk framer-9OjJ3 framer-yAJxk framer-0FlRU framer-wn90E framer-guVoT framer-72rtr7"
				data-framer-root=""
				style="min-height:100vh;width:auto;display:contents"
			>
				<div class="framer-eywkka" data-framer-name="Header change trigger" id="header-change"></div>
				<main class="framer-1v8dk9r" data-framer-name="Main">
					<article class="lg">
						<header class="lg-head">
							<h1>{title}</h1>
							<p class="lg-updated">Última atualização: {updated}</p>
						</header>
						<div class="lg-body">
							<slot />
						</div>
					</article>
				</main>
				<div id="overlay"></div>
				<div class="framer-5gd35e"></div>
				<Header />
				<Footer />
			</div>
		</div>
	</div>

	<SvgDefs />
</BaseLayout>

<style>
	.lg {
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
		padding: 40px 20px 120px;
		box-sizing: border-box;
		font-family: 'Inter', 'Inter Placeholder', system-ui, sans-serif;
		color: #141414;
	}
	.lg-head {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding-bottom: 32px;
		border-bottom: 1px solid #e6e6e6;
	}
	.lg h1 {
		margin: 0;
		font-size: clamp(38px, 5vw, 56px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}
	.lg-updated {
		margin: 0;
		font-size: 14px;
		font-weight: 500;
		color: #909090;
	}
	.lg-body {
		padding-top: 32px;
		font-size: 16px;
		line-height: 1.65;
		color: #3b3f48;
	}
	.lg-body :global(section) {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 28px 0;
		border-bottom: 1px solid #efefef;
	}
	.lg-body :global(section:last-child) {
		border-bottom: 0;
	}
	.lg-body :global(h2) {
		margin: 0;
		font-size: 24px;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: #141414;
	}
	.lg-body :global(p),
	.lg-body :global(ul) {
		margin: 0;
	}
	.lg-body :global(ul) {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-left: 20px;
	}
	.lg-body :global(strong) {
		color: #141414;
		font-weight: 600;
	}
	.lg-body :global(a) {
		color: #0e82f6;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.lg-body :global(.lg-intro) {
		font-size: 17px;
		color: #141414;
	}

	@media (max-width: 809.98px) {
		.lg {
			padding: 24px 20px 80px;
		}
		.lg-body {
			font-size: 15px;
		}
		.lg-body :global(h2) {
			font-size: 20px;
		}
	}
</style>
