e:392.1696787476714px;--framer-font-weight:700;--framer-letter-spacing:-0.08em;--framer-line-height:0.7em;--framer-text-color:var(--token-d85c14b1-24d2-4c6a-85b8-c8df39670cf6, rgb(242, 242, 242))">Respy</p></foreignobject></svg></div></footer>

<script>
	// Envia o e-mail do formulário "Assinar" para a planilha (Google Apps Script).
	const endpoint = import.meta.env.PUBLIC_NEWSLETTER_URL;
	const form = document.querySelector<HTMLFormElement>('footer form.framer-ep79eq');

	if (form) {
		const input = form.querySelector<HTMLInputElement>('input[name="Email"]');
		const label = form.querySelector<HTMLElement>('button[type="submit"] p');
		const original = label?.textContent ?? 'Assinar';
		const honeypots = [...form.querySelectorAll<HTMLInputElement>('input[aria-hidden="true"]')];

		const setLabel = (text: string, reset = false) => {
			if (!label) return;
			label.textContent = text;
			if (reset) window.setTimeout(() => (label.textContent = original), 3000);
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!input || !input.value || honeypots.some((field) => field.value)) return;
			if (!endpoint) {
				setLabel('Indisponível', true);
				return;
			}
			setLabel('Enviando...');
			try {
				// text/plain evita o preflight de CORS que o Apps Script não responde
				await fetch(endpoint, {
					method: 'POST',
					mode: 'no-cors',
					headers: { 'Content-Type': 'text/plain;charset=utf-8' },
					body: JSON.stringify({ email: input.value, page: location.pathname }),
				});
				input.value = '';
				setLabel('Inscrito!', true);
			} catch {
				setLabel('Tente de novo', true);
			}
		});
	}
</script>
