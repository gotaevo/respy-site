		const input = form.querySelector<HTMLInputElement>('input[name="Email"]');
		const label = form.querySelector<HTMLElement>('button[type="submit"] p');
		const original = label?.textContent ?? 'Assinar';
		const honeypots = [...form.querySelectorAll<HTMLInputElement>('input[aria-hidden="true"]')];
		const msg = (key: string) => form.querySelector(`.nl-msgs [data-msg="${key}"]`)?.textContent ?? '';

		const setLabel = (text: string, reset = false) => {
			if (!label) return;
			label.textContent = text;
			if (reset) window.setTimeout(() => (label.textContent = original), 3000);
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!input || !input.value || honeypots.some((field) => field.value)) return;
			if (!endpoint) {
				setLabel(msg('unavailable'), true);
				return;
			}
			setLabel(msg('sending'));
			try {
				// text/plain evita o preflight de CORS que o Apps Script não responde
				await fetch(endpoint, {
					method: 'POST',
					mode: 'no-cors',
					headers: { 'Content-Type': 'text/plain;charset=utf-8' },
					body: JSON.stringify({ email: input.value, page: location.pathname }),
				});
				input.value = '';
				setLabel(msg('done'), true);
			} catch {
				setLabel(msg('retry'), true);
			}
		});
	}
</script>
