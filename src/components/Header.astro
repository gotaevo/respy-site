<style>
	.rh-burger { display: none; }

	/* Tablet e celular: logo + Entrar + menu hambúrguer */
	@media (max-width: 1199.98px) {
		nav.framer-fA8ni .framer-1upubbt { justify-content: space-between; gap: 12px; }
		nav.framer-fA8ni .framer-1t8spqw { width: auto; margin-right: auto; }
		nav.framer-fA8ni .framer-z09zq1-container { width: 112px; height: 40px; flex: none; }
		nav.framer-fA8ni .framer-z09zq1-container > a { width: 100% !important; height: 100% !important; min-width: 0 !important; }

		.rh-burger {
			display: inline-flex; flex-direction: column; justify-content: center; align-items: center; gap: 4px;
			width: 40px; height: 40px; flex: none; padding: 0; border: 0; border-radius: 12px;
			background: #f2f2f2; cursor: pointer; transition: background-color .2s ease;
		}
		.rh-burger:hover { background: #e6e6e6; }
		.rh-burger:focus-visible { outline: 2px solid #0e82f6; outline-offset: 2px; }
		.rh-burger span { display: block; width: 18px; height: 2px; border-radius: 2px; background: #141414; transition: transform .25s ease, opacity .2s ease; }
		nav.rh-open .rh-burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
		nav.rh-open .rh-burger span:nth-child(2) { opacity: 0; }
		nav.rh-open .rh-burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

		/* Menu suspenso */
		nav.framer-fA8ni .framer-ky7o20 {
			position: absolute; top: calc(100% + 12px); left: 0; right: 0; width: auto; flex: none;
			display: flex; flex-direction: column; align-items: stretch; padding: 8px;
			background: #fff; border-radius: 20px; box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 18px 40px -12px rgba(20,30,60,.28);
			opacity: 0; visibility: hidden; transform: translateY(-6px); pointer-events: none;
			transition: opacity .2s ease, transform .2s ease, visibility 0s linear .2s;
		}
		nav.rh-open .framer-ky7o20 {
			opacity: 1 !important; visibility: visible; transform: none !important; pointer-events: auto;
			transition: opacity .2s ease, transform .2s ease;
		}
		nav.framer-fA8ni .framer-ule2kz { flex-direction: column; align-items: stretch; gap: 2px; width: 100%; flex: none; }
		nav.framer-fA8ni .framer-ule2kz > div { width: 100% !important; left: auto !important; }
		nav.framer-fA8ni .framer-ule2kz a { width: 100% !important; justify-content: flex-start !important; padding: 12px 16px; border-radius: 12px; }
		nav.framer-fA8ni .framer-ule2kz a:hover { background: #f2f2f2; }
		nav.framer-fA8ni .framer-ule2kz a p { font-size: 16px !important; }
	}

	@media (max-width: 809.98px) {
		nav.framer-fA8ni .framer-jkirj5-container { width: 104px; height: 32px; }
