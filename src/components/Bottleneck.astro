<style>
	/* Container da seção */
	.framer-lvgkav {
		position: relative;
	}

	/* O bloco de conteúdo fica sticky enquanto o usuário rola o trigger */
	.bottleneck-content {
		position: sticky;
		top: 100px;
		z-index: 2;
	}

	/* Trigger invisível que define a profundidade de scroll do efeito */
	.bottleneck-scroll-trigger {
		height: 70vh;
		width: 100%;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
	}

	/* =======================================
	   ESQUERDA: Linhas e Chips 3D
	   ======================================= */
	.bottleneck-lines-container {
		opacity: 0;
		transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		pointer-events: none;
	}

	.bottleneck-floating-chip {
		will-change: transform;
		transform: translate(-50%, -50%) translateX(-26px) translateY(-89px) scale(1.1) rotate(-15deg);
		transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.bottleneck-chip-shadow {
		filter: drop-shadow(rgba(6, 14, 55, 0.29) 1px 2px 3px)
		        drop-shadow(rgba(6, 14, 55, 0.25) 5px 9px 5px)
		        drop-shadow(rgba(6, 14, 55, 0.15) 12px 19px 5px)
		        drop-shadow(rgba(6, 14, 55, 0.04) 21px 34px 5px)
		        drop-shadow(rgba(6, 14, 55, 0.01) 33px 54px 5px);
		will-change: filter;
		transition: filter 0.75s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* =======================================
	   DIREITA: Card Antes / Depois
	   ======================================= */
	.bottleneck-card {
		position: relative;
		overflow: hidden;
		background: radial-gradient(100% 154% at 84.7% 98.8%, var(--token-6d9f9ffa-d27a-4292-b56a-7331c1a1ae57, rgb(111, 111, 111)) 14.980469644069672%, rgb(78, 78, 78) 50.16547441482544%, rgb(64, 64, 64) 84.55531597137451%);
		box-sizing: border-box;
	}

	.bottleneck-card-layer {
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		padding: 24px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.bottleneck-card-before {
		position: relative;
		z-index: 1;
		opacity: 1;
		transform: translateY(0);
		transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.bottleneck-card-after-bg {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(100% 154% at 84.7% 98.8%, var(--token-ead24edb-3fbf-4222-8946-27a8269e6970, rgb(14, 130, 246)) 14.980469644069672%, rgb(15, 59, 135) 50.16547441482544%, rgb(20, 20, 20) 84.55531597137451%);
		opacity: 0;
		z-index: 2;
		pointer-events: none;
		transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.bottleneck-card-after {
		position: absolute;
		inset: 0;
		z-index: 3;
		opacity: 0;
		transform: translateY(12px);
		pointer-events: none;
		transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.list-icon {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
	}

	.check-icon-wrap {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.check-svg {
		width: 20px;
		height: 20px;
		display: block;
	}

	/* =======================================
	   ESTADO ATIVADO (IS-AFTER)
	   ======================================= */
	:global(.framer-lvgkav.is-after) .bottleneck-lines-container {
		opacity: 1;
	}

	:global(.framer-lvgkav.is-after) .bottleneck-floating-chip {
		transform: translate(-50%, -50%) translateX(0px) translateY(0px) scale(1) rotate(0deg);
	}

	:global(.framer-lvgkav.is-after) .bottleneck-chip-shadow {
		filter: drop-shadow(rgba(6, 14, 55, 0.12) 0px 4px 12px);
	}

	:global(.framer-lvgkav.is-after) .bottleneck-card-before {
		opacity: 0;
		transform: translateY(-12px);
		pointer-events: none;
	}

	:global(.framer-lvgkav.is-after) .bottleneck-card-after-bg {
		opacity: 1;
	}

	:global(.framer-lvgkav.is-after) .bottleneck-card-after {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	/* Ajustes responsivos para tablets e celulares */
	@media (max-width: 809px) {
		.bottleneck-content {
			position: relative;
			top: unset;
		}

		.bottleneck-scroll-trigger {
			height: 40vh;
		}
	}
</style>

