		const section = document.getElementById('bottleneck-section');
		const trigger = document.getElementById('snap');

		if (!section || !trigger) return;

		let ticking = false;

		function checkScroll() {
			if (!ticking) {
				window.requestAnimationFrame(() => {
					const rect = trigger.getBoundingClientRect();
					const windowHeight = window.innerHeight || document.documentElement.clientHeight;

					// Dispara quando o topo do trigger atinge 75% da altura da janela
					const isPast = rect.top <= windowHeight * 0.75;

					if (isPast) {
						section.classList.add('is-after');
					} else {
						section.classList.remove('is-after');
					}

					ticking = false;
				});
				ticking = true;
			}
		}

		window.addEventListener('scroll', checkScroll, { passive: true });
		window.addEventListener('resize', checkScroll, { passive: true });

		// Verificação inicial
		checkScroll();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupBottleneckScroll);
	} else {
		setupBottleneckScroll();
	}

	document.addEventListener('astro:page-load', setupBottleneckScroll);
</script>
