<script>
	const rootSection = document.querySelector('section[data-framer-name="Na rotina da sua equipe"]');
	if (rootSection) {
		const desktopContainer = rootSection.querySelector('.framer-h3Iyg');
		const tabButtons = rootSection.querySelectorAll('.framer-1ex3p6o [data-tab-btn]');
		const leftPanels = rootSection.querySelectorAll('.framer-19kt8jp [data-tab-panel]');
		const rightPanels = rootSection.querySelectorAll('.framer-86ib0a [data-right-panel]');

		const variantClasses = [
			'framer-v-1ataqi6', // Tab 0: Atendentes
			'framer-v-18jfj4r', // Tab 1: Gestores
			'framer-v-1qppwit', // Tab 2: Proprietários
			'framer-v-jdbmmy'   // Tab 3: Financeiro
		];

		const switchTab = (index) => {
			if (!desktopContainer) return;

			// 1. Atualiza classes de variantes no container (ativa regras nativas do Framer CSS)
			desktopContainer.classList.remove(...variantClasses);
			desktopContainer.classList.add(variantClasses[index]);
			desktopContainer.setAttribute('data-framer-name', 'Desktop - ' + (index + 1));

			// 2. Atualiza estado dos botões de abas
			tabButtons.forEach((btn, i) => {
				const isActive = i === index;
				btn.setAttribute('data-framer-name', isActive ? 'Active' : 'Default');
				btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
				const bg = btn.querySelector('.framer-101cqn5');
				const textP = btn.querySelector('.framer-coppna p');
				if (isActive) {
					btn.classList.add('framer-v-byontr');
					btn.classList.remove('framer-v-zmxhm2');
					if (bg) {
						bg.style.setProperty('--border-color', 'var(--token-9d3ef7dc-eeb5-4f6a-982b-fd13c7660eb7, rgb(14, 130, 246))');
						bg.style.backgroundColor = 'var(--token-9d3ef7dc-eeb5-4f6a-982b-fd13c7660eb7, rgb(14, 130, 246))';
					}
					if (textP) {
						textP.style.setProperty('--framer-text-color', 'var(--token-7a9c85e0-dd9a-4f66-a6ab-86722f99b6fc, rgb(255, 255, 255))');
						textP.style.color = 'var(--token-7a9c85e0-dd9a-4f66-a6ab-86722f99b6fc, rgb(255, 255, 255))';
					}
				} else {
					btn.classList.add('framer-v-zmxhm2');
					btn.classList.remove('framer-v-byontr');
					if (bg) {
						bg.style.setProperty('--border-color', 'var(--token-8b591b40-8dc5-4f66-a27d-23ecdeed17e2, rgb(220, 220, 220))');
						bg.style.backgroundColor = 'var(--token-7a9c85e0-dd9a-4f66-a6ab-86722f99b6fc, rgb(255, 255, 255))';
					}
					if (textP) {
						textP.style.setProperty('--framer-text-color', 'var(--token-53572612-5739-47c6-8b1a-4fdcc73f407a, rgb(20, 20, 20))');
						textP.style.color = 'var(--token-53572612-5739-47c6-8b1a-4fdcc73f407a, rgb(20, 20, 20))';
					}
				}
			});

			// 3. Atualiza os painéis da coluna esquerda
			leftPanels.forEach((panel, i) => {
				if (i === index) {
					panel.classList.add('active');
				} else {
					panel.classList.remove('active');
				}
			});

			// 4. Atualiza os painéis da coluna direita
			rightPanels.forEach((panel, i) => {
				if (i === index) {
					panel.classList.add('active');
				} else {
					panel.classList.remove('active');
				}
			});
		};

		tabButtons.forEach((btn, index) => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				switchTab(index);
			});
			btn.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					switchTab(index);
				}
			});
		});
	}
</script>
